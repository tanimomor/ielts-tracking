# Postgres connection string. `vc i neon` / `vercel env pull` provides this.
DATABASE_URL=

# Random string, at least 32 chars: `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the app (http://localhost:3000 locally). Optional on Vercel.
AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google emails that may sign in
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
